# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase value. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 S3-compatible API (server-only). Image uploads are disabled until these are set.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=livo-assets
# Public URL images are served from: the bucket's custom domain or r2.dev URL (not the r2.cloudflarestorage.com API endpoint)
R2_PUBLIC_BASE_URL=https://assets.example.com

# Realtime room server (Cloudflare Worker in apps/realtime), with or without protocol.
# Local: localhost:1999 · Production: livo-realtime.<your-subdomain>.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Public URL of this web app (join links, QR codes, auth emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs room tokens (at least 32 characters). Must match the realtime worker's secret:
# apps/realtime/.dev.vars locally, `npx wrangler secret put ROOM_TOKEN_SECRET` in production.
ROOM_TOKEN_SECRET=replace-with-a-long-random-string-of-32-plus-chars
